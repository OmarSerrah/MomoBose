{
  "name": "momobose",
  "productName": "MomoBose",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "description": "Desktop controls for Bose QC45, Sony WH-1000XM4/XM5, and Apple AirPods.",
  "author": "Momo",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node scripts/start.mjs",
    "demo": "node scripts/start.mjs --demo",
    "package:mac": "npm run build:native && npm run build && node scripts/package-mac.mjs --dir",
    "dist:mac": "npm run build:native && npm run build && node scripts/package-mac.mjs",
    "dist:win": "npm run build:native && npm run build && electron-builder --win nsis zip"
  },
  "build": {
    "appId": "com.momo.momobose",
    "productName": "MomoBose",
    "directories": {
      "output": "release"
    },
    "artifactName": "MomoBose-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "OmarSerrah",
      "repo": "MomoBose",
      "channel": "latest-${arch}"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "native/bin/${os}-${arch}",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "timestamp": "none",
      "entitlements": "native/macos/entitlements.plist",
      "entitlementsInherit": "native/macos/entitlements.plist",
      "extendInfo": {
        "SUFeedURL": "https://github.com/OmarSerrah/MomoBose/releases/latest/download/appcast.xml",
        "SUPublicEDKey": "gI10Ecgvd0s3NnHLvHxL72z0TEnA+BVEbP4i+U5J7fk=",
        "SUVerifyUpdateBeforeExtraction": true,
        "SURequireSignedFeed": true,
        "SUEnableAutomaticChecks": true,
        "SUAutomaticallyUpdate": false,
        "SUScheduledCheckInterval": 14400,
        "NSBluetoothAlwaysUsageDescription": "MomoBose connects to your headphones to show battery and change your sound settings.",
        "NSBluetoothPeripheralUsageDescription": "MomoBose connects to your headphones.",
        "LSMinimumSystemVersion": "12.0"
      }
    },
    "afterPack": "electron-sparkle/electron-builder",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-sparkle": "0.2.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xmldom/xmldom": "0.9.12",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
